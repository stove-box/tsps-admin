{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TSPS Admin",
  "version": "0.1.0",
  "identifier": "app.rsps.tspsadmin",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "TSPS Admin",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#16171a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "resources/tsps-client-setup.exe": "tsps-client-setup.exe" },
    "windows": { "nsis": { "installerHooks": "installer-hooks.nsh" } },
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
